{
  "name": "caojuege-meeting-board",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "草诀歌 AI Labs 会议白板",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server.ts",
    "lint": "tsc --noEmit",
    "deploy": "npm run build && wrangler pages deploy",
    "cf:kv": "wrangler kv namespace create BOARD_KV",
    "cf:dev": "npm run build && wrangler pages dev dist --kv BOARD_KV",
    "clean": "rm -rf dist .wrangler"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260730.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "wrangler": "^4.118.0"
  }
}
